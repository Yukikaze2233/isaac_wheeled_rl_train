  "source_mechanisms": [
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 224,
      "fact": "Large lateral gravity and tilt≥70 degrees select SIDE; FOLD brings geometry to sealed fold."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 279,
      "fact": "SIDE sign is selected from gravity_y; physical signed left/right pair strokes oppose one another, implementing an asymmetric side swing rather than pitch-only correction."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 284,
      "fact": "SIDE exits once abs(gravity_y)<.65 after.05s; it selects a new route and folds unless near upright. Leaving SIDE does not mean upright achieved."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 293,
      "fact": "Sagittal ORBIT uses support and a3.7rad anchor, then THRUST produces pitch recovery; THRUST enters CAPTURE with tilt<65 and height/support/gyro prerequisites."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 240,
      "fact": "CAPTURE/PREPARE leg target aligns sealed prepare command against pitch, limited to4rad/s. No explicit roll correction term is present here."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery_training.py",
      "line": 60,
      "fact": "Effective nominal and support are both replaced by the same authenticated pd_prepare command; extension*(support−nominal) is exactly zero in this runtime."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery.py",
      "line": 301,
      "fact": "CAPTURE→PREPARE requires tilt<20deg/support/height>.22/gyro<.75; final ready uses all eight sensors plus remaining<.02 and measured_error<.12, then20 consecutive ticks."
    },
    {
      "file": "/home/yukikaze/Documents/workspace/robot_rl/.worktrees/serial-dispatch-source028-20261009/src/wheeled_tasks/chassis/recovery_training.py",
      "line": 154,
      "fact": "Outer8s budget includes initial passive release; started blend may finish and the1s RL hold is graded after takeover, not an additional pre-BLEND dwell inside8s."
    }
