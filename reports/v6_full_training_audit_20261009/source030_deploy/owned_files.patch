+def put(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value))
+
+
+def exclusive(path, value):
+    with Path(path).open("x") as stream:
+        json.dump(value, stream)
