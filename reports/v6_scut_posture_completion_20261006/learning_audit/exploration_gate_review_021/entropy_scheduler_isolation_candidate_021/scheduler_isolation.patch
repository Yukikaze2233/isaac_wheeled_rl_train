+    def trial_publish_context(self, directory=None):
+        """Isolate one explicitly owned research publisher; do not launch a trial."""
+        context = getattr(self, "active_trial", None)
+        research_root = (self.root / "research").resolve()
+        research_directory = (directory is not None
+            and (directory.is_relative_to(self.root / "research")
+                 or directory.resolve().is_relative_to(research_root)))
+        if context is None:
+            if research_directory:
+                raise ValueError("Research publisher requires its explicit trial context")
+            return None
+        if (type(context) is not dict
+                or set(context) != {"trial_id", "arm_id", "run_directory"}
+                or any(type(context[key]) is not str or not context[key]
+                       for key in context)):
+            raise ValueError("Research publisher context differs")
+        state = getattr(self, "trial_state", None)
+        expected = Path(context["run_directory"]).resolve()
+        if (type(state) is not dict or state.get("trial_id") != context["trial_id"]
+                or not research_root.is_relative_to(self.root)
+                or not expected.is_relative_to(research_root)
+                or (directory is not None and directory.resolve() != expected)):
+            raise ValueError("Research publisher is not the claimed trial directory")
+        return deepcopy(context)
